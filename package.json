{
  "name": "oblyviumlauncher",
  "version": "3.4.0",
  "productName": "Oblyvium Launcher",
  "description": "Oblyvium Launcher",
  "author": "Oblyvium (https://github.com/OblyviumRP/)",
  "license": "UNLICENSED",
  "homepage": "https://discord.gg/oblyvium",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "npm run ui:build && electron-builder build",
    "dist:win": "npm run dist -- -w",
    "dist:mac": "npm run dist -- -m",
    "dist:linux": "npm run dist -- -l",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "ui:install": "npm --prefix ui install",
    "ui:ci": "npm --prefix ui ci",
    "ui:verify": "npm run ui:build && electron scripts/verify-ui.cjs",
    "ui:dev": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build"
  },
  "engines": {
    "node": "22.x.x"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "adm-zip": "^0.5.16",
    "discord-rpc-patch": "^4.0.1",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.7.3",
    "fs-extra": "^11.3.3",
    "got": "^11.8.5",
    "helios-core": "~2.3.0",
    "helios-distribution-types": "^1.3.0",
    "lodash.merge": "^4.6.2",
    "marked": "^15.0.12",
    "semver": "^7.7.3",
    "toml": "^3.0.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.6.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "eslint": "^9.39.2"
  }
}
