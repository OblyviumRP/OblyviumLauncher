<% const socialPlatforms = [
    { key: 'Discord', label: 'Discord', icon: 'discord' },
    { key: 'Instagram', label: 'Instagram', icon: 'instagram' },
    { key: 'YouTube', label: 'YouTube', icon: 'youtube' },
    { key: 'TikTok', label: 'TikTok', icon: 'tiktok' }
]; %>
<div class="social-links social-links-<%= layout %>">
    <% for (const platform of socialPlatforms) {
        const destination = lang('landing.media' + platform.key + 'URL') || '';
        const available = /^https:\/\//.test(destination);
    %>
        <% if (available) { %>
            <a class="social-link" href="<%= destination %>" aria-label="<%= platform.label %>" title="<%= platform.label %>">
                <span class="social-icon social-icon-<%= platform.icon %>" aria-hidden="true"></span>
                <span class="social-label"><%= platform.label %></span>
                <% if (layout === 'list') { %><span class="social-link-action">Abrir</span><% } %>
            </a>
        <% } else { %>
            <button class="social-link" disabled aria-label="<%= platform.label %> indisponível" title="<%= platform.label %> indisponível">
                <span class="social-icon social-icon-<%= platform.icon %>" aria-hidden="true"></span>
                <span class="social-label"><%= platform.label %></span>
                <% if (layout === 'list') { %><span class="social-link-action">Indisponível</span><% } %>
            </button>
        <% } %>
    <% } %>
</div>
